    // The (uint8_t*) casts below are the export contract's own convention,
    // not an invention here: TileMapGeneric::indices is uint8_t*, and the
    // orthogonal reference export casts exactly this way. The arrays stay
    // flash-resident and nothing ever writes through the pointer.
    void init() {

        // Setup Room0
        room0.width      = MAP_WIDTH;
        room0.height     = MAP_HEIGHT;
        room0.tileWidth  = TILE_WIDTH;
        room0.tileHeight = TILE_HEIGHT;
        room0.indices    = (uint8_t*)ROOM0_INDICES;
        room0.tiles      = TILESET_SPRITES;
        room0.tileCount  = TILESET_TILE_COUNT;
        room0.tileFootY  = TILESET_FOOT_Y;

        // Setup Room1
        room1.width      = MAP_WIDTH;
        room1.height     = MAP_HEIGHT;
        room1.tileWidth  = TILE_WIDTH;
        room1.tileHeight = TILE_HEIGHT;
        room1.indices    = (uint8_t*)ROOM1_INDICES;
        room1.tiles      = TILESET_SPRITES;
        room1.tileCount  = TILESET_TILE_COUNT;
        room1.tileFootY  = TILESET_FOOT_Y;

        // Setup Room2
        room2.width      = MAP_WIDTH;
        room2.height     = MAP_HEIGHT;
        room2.tileWidth  = TILE_WIDTH;
        room2.tileHeight = TILE_HEIGHT;
        room2.indices    = (uint8_t*)ROOM2_INDICES;
        room2.tiles      = TILESET_SPRITES;
        room2.tileCount  = TILESET_TILE_COUNT;
        room2.tileFootY  = TILESET_FOOT_Y;
    }

