    // --- Tileset ---
    // Index 0 is the empty sentinel drawTileMap always skips. It carries
    // ZERO extent, where the orthogonal export emits an all-zero tile of
    // full size. Deliberate: a full-size empty slot would still render
    // correctly if the index-0 skip ever regressed, hiding the regression
    // instead of catching it. No cell in any exported layer may bake to 0.
    const pixelroot32::graphics::Sprite4bpp PIXELROOT32_SCENE_FLASH_ATTR
        TILESET_SPRITES[TILESET_TILE_COUNT] = {
        { nullptr, TILEMAP_PALETTE_MAPPING, 0, 0, 16 },
        { &TILESET_DATA_POOL[0], TILEMAP_PALETTE_MAPPING, 32, 16, 16 },
        { &TILESET_DATA_POOL[256], TILEMAP_PALETTE_MAPPING, 32, 16, 16 },
        { &TILESET_DATA_POOL[512], TILEMAP_PALETTE_MAPPING, 32, 16, 16 },
        { &TILESET_DATA_POOL[768], TILEMAP_PALETTE_MAPPING, 32, 40, 16 },
        { &TILESET_DATA_POOL[1408], TILEMAP_PALETTE_MAPPING, 32, 40, 16 },
        { &TILESET_DATA_POOL[2048], TILEMAP_PALETTE_MAPPING, 32, 40, 16 },
    };

    const uint8_t PIXELROOT32_SCENE_FLASH_ATTR TILESET_FOOT_Y[TILESET_TILE_COUNT] = {
        0,  // empty sentinel, never drawn
        8,  // FLOOR_A
        8,  // FLOOR_B
